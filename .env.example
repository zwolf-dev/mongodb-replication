# MongoDB Replication Tool Configuration
# Environment variables untuk production deployment

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Security Settings  
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# SSH Connection Settings
SSH_TIMEOUT=30
SSH_RETRY_COUNT=3
SSH_RETRY_DELAY=2

# MongoDB Settings
MONGO_TIMEOUT=60
MONGO_RETRY_COUNT=5
DEFAULT_MONGO_PORT=27017

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/mongodb-replication-tool.log

# WebSocket Settings
WS_HEARTBEAT=30
WS_MAX_CONNECTIONS=100

# File Upload Settings
MAX_FILE_SIZE=100MB
UPLOAD_DIR=/tmp/mongodb-uploads

# Benchmark Settings
DEFAULT_BENCHMARK_DOCS=10000
MAX_BENCHMARK_DOCS=1000000

# Demo Mode (set to false for production)
DEMO_MODE=false
